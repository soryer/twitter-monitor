# Twitter API Configuration
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
# 单个用户：TWITTER_USERNAME=cz_binance
# 多个用户（用逗号分隔）：TWITTER_USERNAME=cz_binance,elonmusk,vitalikbuterin
TWITTER_USERNAME=cz_binance

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Proxy Configuration (optional)
# 如果不需要代理，请注释掉或删除下面两行
# 如果需要代理，请将 username、password、proxy-ip、port 替换为实际值
# HTTP_PROXY=http://username:password@proxy-ip:port
# HTTPS_PROXY=http://username:password@proxy-ip:port

# Monitor Configuration
# 检查间隔（毫秒）
# 推荐配置（基于 Twitter API Free Tier 限制）：
# - 1 个用户: 120000 (2分钟) - 每小时 30 次调用
# - 2 个用户: 180000 (3分钟) - 每小时 40 次调用  
# - 3 个用户: 300000 (5分钟) - 每小时 36 次调用
# - 4+ 用户: 600000 (10分钟) - 每小时 24+ 次调用
CHECK_INTERVAL=180000
