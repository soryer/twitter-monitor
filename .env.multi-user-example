# 多用户监控配置示例

# ===== 基础配置 =====

# Twitter API Token
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# 监控的用户（多个用户用逗号分隔）
# 示例1: 监控单个用户
# TWITTER_USERNAME=cz_binance

# 示例2: 监控多个用户（推荐格式，无空格）
# TWITTER_USERNAME=cz_binance,elonmusk,vitalikbuterin

# 示例3: 监控多个用户（允许空格，程序会自动处理）
TWITTER_USERNAME=cz_binance, elonmusk, vitalikbuterin

# ===== Telegram 配置 =====

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ===== 代理配置（可选）=====

# 如果需要代理访问 Twitter API，请配置以下内容：
# 将 username、password、proxy-ip、port 替换为实际值
# HTTP_PROXY=http://username:password@proxy-ip:port
# HTTPS_PROXY=http://username:password@proxy-ip:port

# 如果不需要代理，请保持注释状态（前面有 # 号）

# ===== 监控配置 =====

# 检查间隔（毫秒）
# 根据监控用户数量调整：
# - 1-2 个用户: 60000 (60秒)
# - 3-5 个用户: 90000 (90秒)
# - 6-10 个用户: 120000 (120秒)
CHECK_INTERVAL=90000

# ===== 常见配置场景 =====

# 场景1: 监控加密货币 KOL
# TWITTER_USERNAME=cz_binance,vitalikbuterin,brian_armstrong,SBF_FTX

# 场景2: 监控科技公司 CEO
# TWITTER_USERNAME=elonmusk,BillGates,satyanadella,tim_cook

# 场景3: 监控政治人物
# TWITTER_USERNAME=POTUS,JoeBiden,BarackObama

# 场景4: 监控新闻媒体
# TWITTER_USERNAME=CNN,BBCBreaking,nytimes,Reuters

# 场景5: 监控体育明星
# TWITTER_USERNAME=Cristiano,kingjames,KingJames,FCBarcelona

# ===== 注意事项 =====

# 1. 用户名不要加 @ 符号
# 2. 用逗号分隔，可以有空格
# 3. 监控用户越多，建议增大 CHECK_INTERVAL
# 4. Twitter API 免费版建议不超过 3 个用户
# 5. 详细说明请查看 MULTI_USER_GUIDE.md
